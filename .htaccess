AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType image/vnd.microsoft.icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Rutas de Vite (CSS/JS compilados)
  # Redirige cualquier petición a /build/* hacia back-api/public/build/*
  RewriteRule ^build/(.*)$ back-api/public/build/$1 [L]

  # 2. Rutas de Laravel (Panel, API, Admin)
  # Redirige estas rutas hacia el backend aunque el proyecto viva en una subcarpeta.
  RewriteRule ^(panel|api|admin|login|register|storage|reservations|events)(/.*)?$ back-api/public/index.php [L,QSA]

</IfModule>
